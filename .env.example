# ==============================================================================
# NORTABIL - Configurações de Ambiente
# ==============================================================================

# Ambiente de execução: development, production, test
ENVIRONMENT=development

# Porta do servidor HTTP
PORT=8080

# Conexão com o PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nortabil_db
DB_SSLMODE=disable

# Ou via URL completa:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/nortabil_db?sslmode=disable

# Configurações do Pool de Conexões (pgxpool)
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME_MINUTES=30

# Migrações e Dados Iniciais
AUTO_MIGRATE=true
AUTO_SEED=true

